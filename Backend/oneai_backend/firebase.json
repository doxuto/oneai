{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "memory": "2GB",
      "timeoutSeconds": 120,
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        "service-account.json",
        "*.log",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".DS_Store",
        ".idea"
      ]
    },
    {
      "source": "functions-v2",
      "codebase": "v2",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test",
        ".env.local",
        "*.log",
        ".DS_Store"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/s",
        "function": {
          "functionId": "sharePage",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/legal",
        "function": {
          "functionId": "legal",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/n/**",
        "destination": "/open.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
