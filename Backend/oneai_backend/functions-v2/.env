# Non-secret params, committed on purpose (firebase-functions-pro/config-and-secrets).
# Secrets live in Secret Manager via defineSecret — never here.
LLM_VENDOR=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
ELEVENLABS_MODEL=scribe_v1
MIN_CLIENT_VERSION=2.0.0
# Free: 10 minutes of audio per Vietnam day, one recording at most 10 minutes (decided 24/09).
FREE_DAILY_SECONDS=600
FREE_MAX_DURATION_SECONDS=600
# 0 = unlimited (still counted).
PREMIUM_DAILY_SECONDS=0
# A PDF has no duration: flat charge in seconds.
PDF_CHARGE_SECONDS=300
PREMIUM_MAX_DURATION_SECONDS=14400
FREE_AI_CALLS_DAILY=30
PREMIUM_AI_CALLS_DAILY=300
STT_VENDOR=elevenlabs
STT_FALLBACK_VENDOR=none
GEMINI_STT_MODEL=gemini-2.5-flash
FREE_MAX_ACTIVE_JOBS=1
PREMIUM_MAX_ACTIVE_JOBS=3
FREE_SOURCE_RETENTION_DAYS=7
PREMIUM_SOURCE_RETENTION_DAYS=90
# Share links: empty = the sharePage function URL. After `firebase deploy --only hosting`
# set https://<project>.web.app/s so links are universal/app links (PLATFORM-SETUP.md).
SHARE_BASE_URL=
