{
  "displayName": "One AI \u2014 STT vendor 5xx",
  "documentation": {
    "content": "Vendor is down. Set `STT_FALLBACK_VENDOR` (or switch `STT_VENDOR`) in functions-v2/.env and redeploy.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "oneai_stt_upstream_5xx > 3 in 300s",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/oneai_stt_upstream_5xx\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
