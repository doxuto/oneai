{
  "displayName": "One AI \u2014 processTranscription p95 > 8 min",
  "documentation": {
    "content": "p95 request latency of the worker service over 15 min above 480 s \u2014 jobs are brushing the 540 s limit. Check vendor latency; consider raising memory or lowering FREE_MAX_DURATION_SECONDS.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "p95 latency > 480s",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"processtranscription\"",
        "aggregations": [
          {
            "alignmentPeriod": "900s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 480000,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "alertStrategy": {
    "autoClose": "3600s"
  }
}
