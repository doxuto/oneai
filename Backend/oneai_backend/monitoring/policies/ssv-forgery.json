{
  "displayName": "One AI \u2014 SSV bad signatures",
  "documentation": {
    "content": "Someone is posting to adRewardSsv with invalid signatures. No credit is granted; watch for volume, consider Cloud Armor.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "oneai_ssv_bad_signature > 10 in 3600s",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/oneai_ssv_bad_signature\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 10,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
